# Virtual environment
venv/
.env

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Data & logs
logs/
data/*.db-wal
data/*.db-shm

# Build
build/
dist/
*.spec

# Node & Frontend
node_modules/
pwa/node_modules/
.npm/

# Include pre-built PWA distribution for zero-dependency serving
!pwa/dist/
!pwa/dist/**

# Archive runtime cache
data/archive_cache/
